<Window x:Class="DxpLogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXP Log Viewer" Width="1400" Height="850" AllowDrop="True" Drop="Window_Drop"
        FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>
    <Style x:Key="Lbl" TargetType="TextBlock"><Setter Property="Margin" Value="10,0,4,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#555"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinWidth" Value="110"/><Setter Property="Height" Value="24"/></Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#F3F3F3" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
      <StackPanel>
        <DockPanel>
          <Button Content="Open files..." Click="OpenFiles_Click" Padding="10,3" DockPanel.Dock="Left"/>
          <Button Content="Open folder..." Click="OpenFolder_Click" Padding="10,3" Margin="6,0" DockPanel.Dock="Left"/>
          <Button Content="Clear" Click="Clear_Click" Padding="10,3" DockPanel.Dock="Left"/>
          <Button Content="Export view (CSV)" Click="Export_Click" Padding="10,3" DockPanel.Dock="Right"/>
          <CheckBox x:Name="RegexBox" Content="Regex" VerticalAlignment="Center" Margin="10,0" DockPanel.Dock="Right" Checked="FilterChanged" Unchecked="FilterChanged"/>
          <TextBox x:Name="SearchBox" Margin="12,0,0,0" Height="24" VerticalContentAlignment="Center" TextChanged="FilterChanged"
                   ToolTip="Search all fields. Space = AND. field:value (e.g. severity:error host:0004), -term excludes, &quot;quoted phrases&quot; supported."/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="Severity" Style="{StaticResource Lbl}" Margin="0,0,4,0"/><ComboBox x:Name="SevBox" SelectionChanged="FilterChanged"/>
          <TextBlock Text="Source" Style="{StaticResource Lbl}"/><ComboBox x:Name="SrcBox" SelectionChanged="FilterChanged" MaxWidth="260"/>
          <TextBlock Text="Category" Style="{StaticResource Lbl}"/><ComboBox x:Name="CatBox" SelectionChanged="FilterChanged"/>
          <TextBlock Text="Container" Style="{StaticResource Lbl}"/><ComboBox x:Name="ConBox" SelectionChanged="FilterChanged"/>
          <TextBlock Text="Host" Style="{StaticResource Lbl}"/><ComboBox x:Name="HostBox" SelectionChanged="FilterChanged"/>
          <TextBlock Text="From (UTC)" Style="{StaticResource Lbl}"/><TextBox x:Name="FromBox" Width="130" Height="24" VerticalContentAlignment="Center" TextChanged="FilterChanged" ToolTip="e.g. 2026-10-06 08:30 or 08:30"/>
          <TextBlock Text="To" Style="{StaticResource Lbl}"/><TextBox x:Name="ToBox" Width="130" Height="24" VerticalContentAlignment="Center" TextChanged="FilterChanged"/>
          <Button Content="Reset filters" Click="Reset_Click" Margin="12,0,0,0" Padding="8,0"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock x:Name="StatusText" Text="Drop files or folders here, or use Open."/>
    </StatusBar>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="220"/></Grid.RowDefinitions>
      <DataGrid x:Name="Grid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended"
                CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#EEE" EnableRowVirtualization="True" SelectionChanged="Grid_SelectionChanged">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Background" Value="#FFF8E1"/></DataTrigger>
              <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="Background" Value="#FFE0E0"/></DataTrigger>
              <DataTrigger Binding="{Binding Severity}" Value="Fatal"><Setter Property="Background" Value="#FFC0C0"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time (UTC)" Binding="{Binding Time, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}" SortMemberPath="Time" Width="160"/>
          <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="70"/>
          <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="260"/>
          <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
          <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
          <DataGridTextColumn Header="Container" Binding="{Binding Container}" Width="140"/>
          <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="110"/>
          <DataGridTextColumn Header="File" Binding="{Binding File}" Width="110"/>
        </DataGrid.Columns>
      </DataGrid>
      <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#DDD"/>
      <TabControl Grid.Row="2">
        <TabItem Header="Message">
          <TextBox x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" BorderThickness="0" Padding="6"/>
        </TabItem>
        <TabItem Header="All fields">
          <DataGrid x:Name="FieldsGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" HorizontalGridLinesBrush="#EEE">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Field" Binding="{Binding Key}" Width="200"/>
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Raw JSON">
          <TextBox x:Name="RawBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" BorderThickness="0" Padding="6"/>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
